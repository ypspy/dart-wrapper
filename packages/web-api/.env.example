# 개발: 로컬 SQLite
DATABASE_URL=sqlite+aiosqlite:///./dart_catalog.db
# 웹 배포: Neon PostgreSQL (asyncpg extra 설치 필요)
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME

NODE_EXECUTABLE=node
COLLECTOR_TIMEOUT_SECONDS=900
DART_FETCH_CONCURRENCY=4
DART_FETCH_TIMEOUT_SECONDS=15
DART_FETCH_MAX_RETRIES=2

# Admin 운영 (1인 운영 전제 공유 토큰)
ADMIN_TOKEN=dev-admin-token
# 공시 1건 실패 시 재시도 횟수
DISCLOSURE_MAX_RETRIES=3
# 연속 차단성 응답 임계값 — 넘으면 슬라이스를 blocked로 전환
BLOCK_STREAK_THRESHOLD=5
# blocked 상태에서 재개까지 대기하는 시간(초)
BLOCK_WAIT_SECONDS=60
# 히트맵에 항상 표시할 보고서 유형(쉼표 구분)
HEATMAP_REPORT_TYPES=A001,A002,A003,F001,F002,F004
